def weather_clear_night():
    weather = carla.WeatherParameters()
    weather.cloudiness = 10.0
    weather.precipitation = 0.0
    weather.precipitation_deposits = 0.0
    weather.wind_intensity = 5.0
    weather.sun_azimuth_angle = 0.0
    weather.sun_altitude_angle = -25.0
    weather.fog_density = 5.0
    weather.fog_distance = 80.0
    weather.wetness = 0.0
    return weather


def weather_rain_night():
    weather = carla.WeatherParameters()
    weather.cloudiness = 90.0
    weather.precipitation = 80.0
    weather.precipitation_deposits = 80.0
    weather.wind_intensity = 50.0
    weather.sun_azimuth_angle = 0.0
    weather.sun_altitude_angle = -25.0
    weather.fog_density = 20.0
    weather.fog_distance = 50.0
    weather.wetness = 90.0
    return weather


def get_weather_by_name(name):
    if name == "ClearNoon":
        return carla.WeatherParameters.ClearNoon
    if name == "HardRainNoon":
        return carla.WeatherParameters.HardRainNoon
    if name == "CloudySunset":
        return carla.WeatherParameters.CloudySunset
    if name == "ClearSunset":
        return carla.WeatherParameters.ClearSunset
    if name == "ClearNight":
        return weather_clear_night()
    if name == "RainNight":
        return weather_rain_night()

    raise ValueError(f"Unknown weather condition: {name}")

def update_spectator_follow(spectator, vehicle):
    """
    Moves the CARLA viewport camera so it follows behind the ego vehicle.
    This does not affect the recorded stereo camera data.
    It only changes what you see in the CARLA window.
    """
    ego_tf = vehicle.get_transform()
    forward = ego_tf.get_forward_vector()

    spectator_location = carla.Location(
        x=ego_tf.location.x - 8.0 * forward.x,
        y=ego_tf.location.y - 8.0 * forward.y,
        z=ego_tf.location.z + 4.0
    )

    spectator_rotation = carla.Rotation(
        pitch=-20.0,
        yaw=ego_tf.rotation.yaw,
        roll=0.0
    )

    spectator.set_transform(
        carla.Transform(spectator_location, spectator_rotation)
    )

